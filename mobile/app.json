{
  "expo": {
    "name": "Shopit",
    "slug": "shopit",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./src/assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "shopit",
    "splash": {
      "image": "./src/assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#F4EFE6"
    },
    "updates": {
      "fallbackToCacheTimeout": 0
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.gustavosilva.shopapp",
      "infoPlist": {
        "NSSpeechRecognitionUsageDescription": "O Shopit transforma o que você fala em itens da lista.",
        "NSMicrophoneUsageDescription": "O Shopit usa o microfone para anotar o que você precisa comprar."
      }
    },
    "android": {
      "package": "com.gustavosilva.shopapp",
      "softwareKeyboardLayoutMode": "resize",
      "predictiveBackGestureEnabled": false,
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/adaptive-icon.png",
        "backgroundColor": "#F4EFE6"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./src/assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      "expo-splash-screen",
      [
        "expo-camera",
        {
          "cameraPermission": "O Shopit usa a câmera para identificar o produto e ler o preço impresso na embalagem.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "O Shopit usa o microfone para anotar o que você precisa comprar.",
          "speechRecognitionPermission": "O Shopit transforma o que você fala em itens da lista.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox"
          ]
        }
      ],
      "expo-ocr-kit",
      "expo-status-bar"
    ],
    "description": "Listas de compra com preço, no celular.",
    "extra": {
      "eas": {
        "projectId": "2be03a94-231b-485f-9104-ef8fa567642d"
      }
    }
  }
}
